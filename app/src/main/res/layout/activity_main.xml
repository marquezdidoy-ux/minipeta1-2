<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main_green"
    tools:context=".MainActivity"
    tools:ignore="Autofill,LabelFor,TouchTargetSizeCheck,HardcodedText,RtlSymmetry,RtlHardcoded,TextFields,UseCompoundDrawables">

    <!-- MAIN SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="16dp">

            <!-- HEADER SECTION -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvFantastic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fantastic"
                    android:textColor="@color/gold_yellow"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_toEndOf="@id/tvFantastic"
                    android:layout_alignTop="@id/tvFantastic"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/ic_airplane_trail"
                    android:contentDescription="Paper airplane" />

            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HELLO, USER!"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="20dp" />

            <!-- SEARCH BAR -->
            <EditText
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search"
                android:hint="Search"
                android:textColor="@color/white"
                android:textColorHint="@color/light_teal_hint"
                android:textSize="14sp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="12dp"
                android:maxLines="1"
                android:inputType="text"
                android:layout_marginBottom="28dp" />

            <!-- 2x2 CARDS GRID -->

            <!-- ROW 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:weightSum="2"
                android:layout_marginBottom="20dp">

                <!-- CARD 1: ASSIGNMENTS -->
                <LinearLayout
                    android:id="@+id/cardAssignments"
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_card_outline"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_book"
                        android:contentDescription="Assignments icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ASSIGNMENTS"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check your\nworks."
                        android:textColor="@color/light_teal_hint"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <!-- CARD 2: CHALLENGES -->
                <LinearLayout
                    android:id="@+id/cardChallenges"
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_card_outline"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_brain_challenges"
                        android:contentDescription="Challenges icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHALLENGES"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Test your\nknowledge!"
                        android:textColor="@color/light_teal_hint"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ROW 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:weightSum="2"
                android:layout_marginBottom="20dp">

                <!-- CARD 3: MESSAGES -->
                <LinearLayout
                    android:id="@+id/cardMessages"
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_card_outline"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_envelope_messages"
                        android:contentDescription="Messages icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MESSAGES"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check messages from\nstudents &amp; teachers"
                        android:textColor="@color/light_teal_hint"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <!-- CARD 4: LEARN -->
                <LinearLayout
                    android:id="@+id/cardLearn"
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_card_outline"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_lightbulb_learn"
                        android:contentDescription="Learn icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LEARN"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Learn new\nthings!"
                        android:textColor="@color/light_teal_hint"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM PANEL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="@drawable/bg_bottom_panel">

        <!-- User profile section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_user_profile"
                android:contentDescription="User profile icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textColor="@color/gold_yellow"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginStart="10dp" />

        </LinearLayout>

        <!-- Right icons: Notification & Settings -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnNotificationMain"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_bell_notification"
                android:background="@drawable/bg_circle_icon"
                android:padding="7dp"
                android:contentDescription="Notification bell" />

            <ImageView
                android:id="@+id/btnSettingsMain"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_settings_gear"
                android:background="@drawable/bg_circle_icon"
                android:padding="7dp"
                android:layout_marginStart="12dp"
                android:contentDescription="Settings gear" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>